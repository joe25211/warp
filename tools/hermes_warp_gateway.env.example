# Copy to ~/.config/hermes-warp-gateway/env for the user systemd unit, or source before running script/run-hermes-warp-gateway.
# Override this only if the checkout lives somewhere else. The packaged systemd unit
# defaults it to %h/Projects/warp-hermes-native before reading this file.
# HERMES_WARP_GATEWAY_REPO=/path/to/warp-hermes-native

HERMES_WARP_GATEWAY_HOST=127.0.0.1
HERMES_WARP_GATEWAY_PORT=8976
HERMES_WARP_GATEWAY_DB=~/.local/share/hermes-warp-gateway/drive.sqlite

# Advertised in gateway health/model responses. Point these at Tailscale URLs when serving other machines.
HERMES_BASE_URL=http://127.0.0.1:9120
OPENAI_BASE_URL=http://127.0.0.1:8787/v1
HERMES_WARP_DEFAULT_MODEL=hermes/migi-default

# Self-host session-sharing relay URL advertised to Warp. By default the gateway owns
# the first relay adapter routes on the same host/port as the HTTP/GraphQL surface.
WARP_SESSION_SHARING_SERVER_URL=ws://127.0.0.1:8976
