# Copy to ~/.config/hermes-warp-gateway/env for the user systemd unit, or source before running script/run-hermes-warp-gateway.

HERMES_WARP_GATEWAY_HOST=127.0.0.1
HERMES_WARP_GATEWAY_PORT=8976
HERMES_WARP_GATEWAY_DB=/home/joe/.local/share/hermes-warp-gateway/drive.sqlite

# Advertised in gateway health/model responses. Point these at Tailscale URLs when serving other machines.
HERMES_BASE_URL=http://127.0.0.1:9120
OPENAI_BASE_URL=http://127.0.0.1:8787/v1
HERMES_WARP_DEFAULT_MODEL=hermes/migi-default
